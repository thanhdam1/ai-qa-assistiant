# ==============================================================================
# CẤU HÌNH AI PROVIDER (CHỌN GEMINI HOẶC OPENAI)
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Cấu hình OpenAI (Nếu dùng OpenAI)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ==============================================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU & HỆ THỐNG
# ==============================================================================
DATABASE_URL=postgresql+psycopg://qa_agent:qa_agent@db:5432/qa_agent
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
MAX_STORY_CHARS=30000

# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG STAGING / PRODUCTION
# ==============================================================================
# CORS: Thêm domain / IP máy chủ Staging của bạn vào đây (phân cách bằng dấu phẩy)
# Ví dụ: http://localhost:5173,http://localhost,https://qa-staging.company.com,http://192.168.1.100:5173
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173

# VITE_API_URL:
# - Môi trường Staging (có Nginx Proxy): Dùng "/api" (Same-Origin, triệt tiêu lỗi CORS)
# - Môi trường Dev tách biệt: Dùng "http://localhost:8000/api"
VITE_API_URL=/api
